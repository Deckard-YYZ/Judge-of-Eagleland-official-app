{
  "stories": {
    "judgment_notice": {
      "skippable": false,
      "steps": [
        {
          "id": "information",
          "type": "text"
        },
        {
          "id": "required_action",
          "type": "actionInput"
        }
      ]
    }
  },
  "endings": {},
  "assets": {},
  "flow": {
    "initialStageId": "registration",
    "stages": {
      "registration": {
        "when": {
          "all": [
            {
              "type": "attributeAtLeast",
              "attributeId": "authority",
              "value": 0
            }
          ]
        },
        "transitions": [
          {
            "id": "review_after_verdict",
            "when": {
              "all": [
                {
                  "type": "currentStage",
                  "stageId": "registration"
                },
                {
                  "type": "caseResolved",
                  "caseId": "intake",
                  "resolutionId": "approved"
                }
              ]
            },
            "targetStageId": "review"
          },
          {
            "id": "appeal_qualified",
            "when": {
              "all": [
                {
                  "type": "attributeAtLeast",
                  "attributeId": "authority",
                  "value": 5
                }
              ]
            },
            "targetStageId": "appeal"
          }
        ]
      },
      "review": {
        "when": {
          "all": [
            {
              "type": "attributeAtLeast",
              "attributeId": "authority",
              "value": 1
            }
          ]
        },
        "transitions": [
          {
            "id": "review_complete",
            "when": {
              "all": [
                {
                  "type": "caseResolved",
                  "caseId": "followup",
                  "resolutionId": "followup_closed"
                },
                {
                  "type": "chatLastNode",
                  "chatId": "clerk_intro",
                  "nodeId": "done"
                }
              ]
            },
            "targetStageId": "completed"
          },
          {
            "id": "review_appeal",
            "when": {
              "any": [
                {
                  "type": "attributeAtLeast",
                  "attributeId": "authority",
                  "value": 5
                },
                {
                  "type": "chatLastNode",
                  "chatId": "appeal_chat",
                  "nodeId": "done"
                }
              ]
            },
            "targetStageId": "appeal"
          }
        ]
      },
      "appeal": {
        "when": {
          "any": [
            {
              "type": "attributeAtLeast",
              "attributeId": "authority",
              "value": 5
            },
            {
              "type": "chatLastNode",
              "chatId": "clerk_intro",
              "nodeId": "done"
            }
          ]
        },
        "transitions": [
          {
            "id": "appeal_complete",
            "when": {
              "all": [
                {
                  "type": "chatLastNode",
                  "chatId": "appeal_chat",
                  "nodeId": "done"
                }
              ]
            },
            "targetStageId": "completed"
          }
        ]
      },
      "completed": {
        "when": {
          "all": [
            {
              "type": "resolvedCountAtLeast",
              "count": 2
            }
          ]
        },
        "transitions": []
      }
    },
    "chats": {
      "clerk_intro": {
        "characterId": "clerk",
        "when": {
          "all": [
            {
              "type": "currentStage",
              "stageId": "review"
            },
            {
              "type": "attributeAtLeast",
              "attributeId": "authority",
              "value": 1
            }
          ]
        },
        "startNodeId": "greeting",
        "nodes": {
          "greeting": {
            "type": "message",
            "replies": [
              {
                "id": "accept",
                "when": {
                  "all": [
                    {
                      "type": "attributeAtLeast",
                      "attributeId": "authority",
                      "value": 1
                    }
                  ]
                },
                "target": {
                  "type": "node",
                  "nodeId": "done"
                }
              },
              {
                "id": "ask",
                "when": {
                  "all": [
                    {
                      "type": "flagEquals",
                      "flagId": "judged",
                      "value": true
                    }
                  ]
                },
                "target": {
                  "type": "node",
                  "nodeId": "details"
                }
              },
              {
                "id": "schedule",
                "when": {
                  "all": [
                    {
                      "type": "attributeAtLeast",
                      "attributeId": "authority",
                      "value": 1
                    }
                  ]
                },
                "target": {
                  "type": "event",
                  "eventId": "schedule_followup"
                }
              }
            ],
            "externalBranches": [
              {
                "id": "followup_received",
                "event": {
                  "type": "caseResolved",
                  "caseId": "followup",
                  "resolutionId": "followup_closed"
                },
                "when": {
                  "all": [
                    {
                      "type": "resolvedCountAtLeast",
                      "count": 2
                    }
                  ]
                },
                "targetNodeId": "done",
                "consequences": [
                  {
                    "type": "unlockChats",
                    "chatIds": [
                      "appeal_chat"
                    ]
                  }
                ]
              }
            ]
          },
          "details": {
            "type": "message",
            "replies": [
              {
                "id": "acknowledge",
                "when": {
                  "all": [
                    {
                      "type": "attributeAtLeast",
                      "attributeId": "authority",
                      "value": 0
                    }
                  ]
                },
                "target": {
                  "type": "node",
                  "nodeId": "done"
                }
              }
            ]
          },
          "done": {
            "type": "terminal",
            "consequences": [
              {
                "type": "unlockChats",
                "chatIds": [
                  "appeal_chat"
                ]
              }
            ]
          }
        }
      },
      "appeal_chat": {
        "characterId": "judge",
        "when": {
          "any": [
            {
              "type": "currentStage",
              "stageId": "appeal"
            },
            {
              "type": "chatLastNode",
              "chatId": "clerk_intro",
              "nodeId": "done"
            }
          ]
        },
        "startNodeId": "notice",
        "nodes": {
          "notice": {
            "type": "message",
            "replies": [
              {
                "id": "understood",
                "when": {
                  "all": [
                    {
                      "type": "attributeAtLeast",
                      "attributeId": "authority",
                      "value": 0
                    }
                  ]
                },
                "target": {
                  "type": "node",
                  "nodeId": "done"
                }
              }
            ]
          },
          "done": {
            "type": "terminal",
            "consequences": [
              {
                "type": "unlockCases",
                "caseIds": [
                  "deferred"
                ]
              }
            ]
          }
        }
      }
    },
    "events": {
      "schedule_followup": {
        "when": {
          "all": [
            {
              "type": "attributeAtLeast",
              "attributeId": "authority",
              "value": 1
            }
          ]
        },
        "consequences": [
          {
            "type": "unlockCases",
            "caseIds": [
              "followup"
            ]
          },
          {
            "type": "enterStage",
            "stageId": "review"
          }
        ]
      }
    }
  }
}
