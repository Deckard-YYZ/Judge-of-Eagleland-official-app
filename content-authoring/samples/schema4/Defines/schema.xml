<module name="">
  <enum name="TargetKind">
    <var name="Node" value="1" />
    <var name="Resolution" value="2" />
  </enum>
  <enum name="EffectKind">
    <var name="AttributeDelta" value="1" />
    <var name="SetFlag" value="2" />
  </enum>
  <bean name="Attribute">
    <var name="id" type="string" />
    <var name="initial" type="int" />
    <var name="min" type="int" />
    <var name="max" type="int" />
  </bean>
  <table name="TbAttribute" value="Attribute" input="attribute.csv" />
  <bean name="Case">
    <var name="id" type="string" />
    <var name="order" type="int" />
    <var name="startNodeId" type="string" />
    <var name="initial" type="bool" />
  </bean>
  <table name="TbCase" value="Case" input="case.csv" />
  <bean name="Node">
    <var name="id" type="string" />
    <var name="caseId" type="string" />
  </bean>
  <table name="TbNode" value="Node" input="node.csv" />
  <bean name="Choice">
    <var name="id" type="string" />
    <var name="caseId" type="string" />
    <var name="nodeId" type="string" />
    <var name="targetKind" type="TargetKind" />
    <var name="targetId" type="string" />
    <var name="hasAnnotation" type="bool" />
  </bean>
  <table name="TbChoice" value="Choice" input="choice.csv" />
  <bean name="Resolution">
    <var name="id" type="string" />
    <var name="caseId" type="string" />
  </bean>
  <table name="TbResolution" value="Resolution" input="resolution.csv" />
  <bean name="Effect">
    <var name="id" type="string" />
    <var name="caseId" type="string" />
    <var name="resolutionId" type="string" />
    <var name="kind" type="EffectKind" />
    <var name="key" type="string" />
    <var name="amount" type="int" />
    <var name="enabled" type="bool" />
  </bean>
  <table name="TbEffect" value="Effect" input="effect.csv" />
</module>