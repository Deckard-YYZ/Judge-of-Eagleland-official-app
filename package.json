{
  "name": "eagle-judge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run voice:check && vite",
    "build": "tsc --noEmit && npm run voice:check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:storage": "vitest run tests/storage",
    "test:platform": "vitest run tests/platform",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,js,ts}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,tsx,json,html,css}\" --ignore-unknown",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,js,ts}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,tsx,json,html,css}\" --ignore-unknown",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run voice:check && npm run test && npm run check:boundaries && npm run format:check",
    "validate:content": "tsx scripts/validate-content.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "diagnostics:archive": "node scripts/archive-diagnostics.mjs",
    "voice:prepare": "tsx scripts/voice-keywords.ts --raw && python -X utf8 scripts/prepare-voice.py && tsx scripts/voice-keywords.ts --check",
    "voice:check": "tsx scripts/voice-keywords.ts --check",
    "voice:cli:build": "node scripts/build-voice-cli.mjs",
    "asr:prepare": "python -X utf8 scripts/prepare-asr.py",
    "tts:prepare": "python -X utf8 scripts/prepare-tts.py",
    "tts:smoke": "cargo run --locked --manifest-path src-tauri/Cargo.toml -- --tts-model-smoke",
    "asr:cli:build": "node scripts/build-asr-cli.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-sql": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
