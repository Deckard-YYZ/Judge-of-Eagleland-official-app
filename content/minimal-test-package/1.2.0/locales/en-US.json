    "tutorial_voice_order": {
      "title": "Input Tutorial",
      "steps": {
        "intro": {
          "blocks": [
            {
              "type": "paragraph",
              "text": "Follow the next prompt to complete a simple input."
            }
          ]
        },
        "order": {
          "blocks": [
            {
              "type": "paragraph",
              "text": "Please salute. Type 'salute', or start recording after the narration stops."
            }
          ],
          "narrationText": "Please salute."
        },
        "after_order": {
          "blocks": [
            {
              "type": "paragraph",
              "text": "Input complete. You may continue."
            }
          ]
        }
