  "configuration": {
    "interactionOnly": {
      "attributeIds": [],
      "flagIds": []
    },
    "instructions": {
      "first-instruction": {
        "caseId": "case-a",
        "nodeId": "case-a-1",
        "choiceId": "case-a-choose-1",
        "delayMs": 1200
      }
    },
    "actionInputHooks": [],
    "casePools": {},
    "dispatchRules": []
  },
  "mainFlow": {
    "initialNodeId": "start",
    "tutorialStoryId": "tutorial",
    "nodes": {
      "start": {
        "stageId": "intake",
        "onEnter": [
          {
            "type": "dispatchCase",
            "caseId": "case-a"
          },
          {
            "type": "startChat",
            "instanceId": "instance-a",
            "chatId": "chat-a"
          },
          {
            "type": "publishNews",
            "newsId": "news-n"
          }
        ],
        "transitions": [
          {
            "id": "normal-result",
            "when": {
              "all": [
                {
                  "type": "chatResult",
                  "instanceId": "instance-a",
                  "resultId": "normal"
                }
              ]
            },
            "targetNodeId": "normal"
          },
          {
            "id": "ignored-result",
            "when": {
              "all": [
                {
                  "type": "chatResult",
                  "instanceId": "instance-a",
                  "resultId": "ignored"
                }
              ]
            },
            "targetNodeId": "ignored"
          }
        ]
      },
      "normal": {
        "stageId": "review",
        "onEnter": [
          {
            "type": "openPool",
            "poolId": "pool-p"
          },
          {
            "type": "dispatchPool",
            "poolId": "pool-p",
            "strategy": {
              "type": "ordered",
              "caseIds": [
                "case-b"
              ]
            }
          },
          {
            "type": "publishNews",
            "newsId": "news-normal"
          }
        ],
        "transitions": [
          {
            "id": "normal-to-special",
            "when": {
              "all": [
                {
                  "type": "caseResolved",
                  "caseId": "case-a"
                }
              ]
            },
            "targetNodeId": "special"
          }
        ]
      },
      "ignored": {
        "stageId": "review",
        "onEnter": [
          {
            "type": "openPool",
            "poolId": "pool-p"
          },
          {
            "type": "dispatchPool",
            "poolId": "pool-p",
            "strategy": {
              "type": "ordered",
              "caseIds": [
                "case-b"
              ]
            }
          },
          {
            "type": "publishNews",
            "newsId": "news-ignored"
          }
        ],
        "transitions": [
          {
            "id": "ignored-to-special",
            "when": {
              "all": [
                {
                  "type": "caseResolved",
                  "caseId": "case-a"
                }
              ]
            },
            "targetNodeId": "special"
          }
        ]
      },
      "special": {
        "stageId": "review",
        "onEnter": [
          {
            "type": "startChat",
            "instanceId": "instance-b",
            "chatId": "chat-b"
          },
          {
            "type": "startChat",
            "instanceId": "instance-c",
            "chatId": "chat-c"
          }
        ],
        "transitions": [
          {
            "id": "both-finished",
            "when": {
              "all": [
                {
                  "type": "caseResolved",
                  "caseId": "case-b"
                },
                {
                  "type": "chatResult",
                  "instanceId": "instance-b",
                  "resultId": "ignored"
                },
                {
                  "type": "chatResult",
                  "instanceId": "instance-c",
                  "resultId": "ignored"
                }
              ]
            },
            "targetNodeId": "followup"
          },
          {
            "id": "both-normal-normal",
            "when": {
              "all": [
                {
                  "type": "caseResolved",
                  "caseId": "case-b"
                },
                {
                  "type": "chatResult",
                  "instanceId": "instance-b",
                  "resultId": "normal"
                },
                {
                  "type": "chatResult",
                  "instanceId": "instance-c",
                  "resultId": "normal"
                }
              ]
            },
            "targetNodeId": "followup"
          },
          {
            "id": "both-normal-ignored",
            "when": {
              "all": [
                {
                  "type": "caseResolved",
                  "caseId": "case-b"
                },
                {
                  "type": "chatResult",
                  "instanceId": "instance-b",
                  "resultId": "normal"
                },
                {
                  "type": "chatResult",
                  "instanceId": "instance-c",
                  "resultId": "ignored"
                }
              ]
            },
            "targetNodeId": "followup"
          },
          {
            "id": "both-ignored-normal",
            "when": {
              "all": [
                {
                  "type": "caseResolved",
                  "caseId": "case-b"
                },
                {
                  "type": "chatResult",
                  "instanceId": "instance-b",
                  "resultId": "ignored"
                },
                {
                  "type": "chatResult",
                  "instanceId": "instance-c",
                  "resultId": "normal"
                }
              ]
            },
            "targetNodeId": "followup"
          }
        ]
      },
      "followup": {
        "stageId": "followup",
        "onEnter": [
          {
            "type": "dispatchCase",
            "caseId": "case-c"
          }
        ],
        "transitions": [
          {
            "id": "c-finished",
            "when": {
              "all": [
                {
                  "type": "caseResolved",
                  "caseId": "case-c"
                }
              ]
            },
            "targetNodeId": "done"
          }
        ]
      },
      "done": {
        "stageId": "followup",
        "onEnter": [],
        "transitions": []
      }
    },
    "chats": {
      "chat-a": {
        "characterId": "clerk",
        "startNodeId": "hello",
        "nodes": {
          "hello": {
            "type": "message",
            "replies": [
              {
                "id": "ack",
                "targetNodeId": "detail"
              }
            ]
          },
          "detail": {
            "type": "message",
            "replies": [
              {
                "id": "finish",
                "targetNodeId": "closed"
              }
            ]
          },
          "closed": {
            "type": "terminal",
            "resultId": "normal"
          }
        },
        "inactivity": {
          "choiceThreshold": 2,
          "resultId": "ignored"
        }
      },
      "chat-b": {
        "characterId": "clerk",
        "startNodeId": "hello",
        "nodes": {
          "hello": {
            "type": "message",
            "replies": [
              {
                "id": "ack",
                "targetNodeId": "detail"
              }
            ]
          },
          "detail": {
            "type": "message",
            "replies": [
              {
                "id": "finish",
                "targetNodeId": "closed"
              }
            ]
          },
          "closed": {
            "type": "terminal",
            "resultId": "normal"
          }
        },
        "inactivity": {
          "choiceThreshold": 2,
          "resultId": "ignored"
        }
      },
      "chat-c": {
        "characterId": "clerk",
        "startNodeId": "hello",
        "nodes": {
          "hello": {
            "type": "message",
            "replies": [
              {
                "id": "ack",
                "targetNodeId": "detail"
              }
            ]
          },
          "detail": {
            "type": "message",
            "replies": [
              {
                "id": "finish",
                "targetNodeId": "closed"
              }
            ]
          },
          "closed": {
            "type": "terminal",
            "resultId": "normal"
          }
        },
        "inactivity": {
          "choiceThreshold": 2,
          "resultId": "ignored"
        }
      }
    },
    "casePools": {
      "pool-p": {
        "members": [
          {
            "caseId": "case-b",
            "when": {
              "any": [
                {
                  "type": "mainNode",
                  "nodeId": "normal"
                },
                {
                  "type": "mainNode",
                  "nodeId": "ignored"
                }
              ]
            }
          }
        ]
      }
    },
    "news": {
      "news-n": {
        "actionStoryId": "news-ack"
      },
      "news-normal": {},
      "news-ignored": {}
    }
  }
