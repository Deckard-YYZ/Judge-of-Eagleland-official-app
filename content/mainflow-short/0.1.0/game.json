    "case-c": {
      "id": "case-c",
      "order": 3,
      "startNodeId": "case-c-1",
      "characters": [
        {
          "id": "clerk"
        }
      ],
      "nodes": {
        "case-c-1": {
          "choices": [
            {
              "id": "case-c-choose-1",
              "hasAnnotation": false,
              "target": {
                "type": "node",
                "nodeId": "case-c-2"
              }
            }
          ]
        },
        "case-c-2": {
          "choices": [
            {
              "id": "case-c-choose-2",
              "hasAnnotation": false,
              "target": {
                "type": "node",
                "nodeId": "case-c-3"
              }
            }
          ]
        },
